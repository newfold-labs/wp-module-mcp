#: includes/Abilities/ColorGen.php:74
msgid "Unable to retrieve Hiive authentication token for palette generation."
msgstr "Kan Hiive-authenticatietoken niet ophalen voor paletgeneratie."

#: includes/Abilities/ColorGen.php:79
msgid "A prompt is required."
msgstr "Een prompt is vereist."

#: includes/Abilities/ColorGen.php:103
msgid "Palette generation timed out."
msgstr "Palettegeneratie liep uit."

#. translators: %s: error message
#: includes/Abilities/ColorGen.php:108
#, php-format
msgid "Palette generation service unavailable: %s"
msgstr "Palettegeneratiedienst niet beschikbaar: %s"

#. translators: %d: HTTP status code
#: includes/Abilities/ColorGen.php:117
#, php-format
msgid "Palette generation failed with status %d."
msgstr "Palettegeneratie mislukte met status %d."

#: includes/Abilities/ColorGen.php:123
msgid "No palettes returned by the generation service."
msgstr "Geen paletten die door de generatieservice worden teruggegeven."

#. translators: %d: number of palettes
#: includes/Abilities/ColorGen.php:145
#, php-format
msgid "%d color palette(s) generated. Present them to the user and apply the chosen one with blu/update-global-styles."
msgstr "%d kleurpalet(en) gegenereerd. Presenteer ze aan de gebruiker en pas de gekozen toe met blu/update-global-styles."

#: includes/Abilities/DocumentRead.php:57
#: includes/Abilities/LogoGen.php:297
msgid "A valid source_url is required."
msgstr "Een geldige source_url is vereist."

#: includes/Abilities/DocumentRead.php:64
#: includes/Abilities/DocumentRead.php:71
msgid "Document not found or not accessible."
msgstr "Document niet gevonden of niet toegankelijk."

#: includes/Abilities/DocumentRead.php:82
msgid "Document exceeds the 50 MB size limit."
msgstr "Het document overschrijdt de limiet van 50 MB."

#: includes/Abilities/DocumentRead.php:93
msgid "Unsupported document type."
msgstr "Niet ondersteund documenttype."

#: includes/Abilities/DocumentRead.php:97
msgid "Could not read document content."
msgstr "Kon de inhoud van het document niet lezen."

#: includes/Abilities/DocumentRead.php:113
msgid "Document content (truncated to 30 000 characters)."
msgstr "Documentinhoud (ingekort tot 30.000 tekens)."

#: includes/Abilities/DocumentRead.php:114
msgid "Document content read successfully."
msgstr "Documentinhoud succesvol gelezen."

#: includes/Abilities/ImageEdit.php:145
msgid "GD image library is not available on this server."
msgstr "De GD-afbeeldingsbibliotheek is niet beschikbaar op deze server."

#: includes/Abilities/ImageEdit.php:151
msgid "A valid image_url is required."
msgstr "Een geldige image_url is vereist."

#: includes/Abilities/ImageEdit.php:155
msgid "The image_url is not allowed."
msgstr "De image_url is niet toegestaan."

#: includes/Abilities/ImageEdit.php:171
msgid "No distinct colors found. The image may be mostly white, black, or transparent."
msgstr "Geen duidelijke kleuren gevonden. De afbeelding kan grotendeels wit, zwart of transparant zijn."

#. translators: %s: dominant hex color value
#: includes/Abilities/ImageEdit.php:183
#, php-format
msgid "Dominant color: %s. Use this hex value with blu/update-global-styles to apply it as the accent or primary color."
msgstr "Dominante kleur: %s. Gebruik deze hex-waarde met blu/update-global-stijlen om het toe te passen als accent of primaire kleur."

#: includes/Abilities/ImageEdit.php:456
msgid "Local source image not found."
msgstr "Lokale bronafbeelding niet gevonden."

#: includes/Abilities/ImageEdit.php:463
msgid "Could not read local source image."
msgstr "Kon de lokale bronafbeelding niet lezen."

#: includes/Abilities/ImageEdit.php:470
#: includes/Abilities/ImageEdit.php:527
msgid "Source image exceeds 10 MB limit."
msgstr "Bronafbeelding overschrijdt de limiet van 10 MB."

#: includes/Abilities/ImageEdit.php:483
#: includes/Abilities/ImageEdit.php:535
msgid "Unsupported source image type."
msgstr "Niet ondersteund bronafbeeldingstype."

#. translators: %s: error message from wp_remote_get
#: includes/Abilities/ImageEdit.php:505
#, php-format
msgid "Unable to fetch source image: %s"
msgstr "Bronafbeelding niet kunnen ophalen: %s"

#. translators: %d: HTTP status code
#: includes/Abilities/ImageEdit.php:513
#, php-format
msgid "Unable to fetch source image (HTTP %d)."
msgstr "Kan bronimage niet ophalen (HTTP %d)."

#: includes/Abilities/ImageEdit.php:520
msgid "Source image is empty."
msgstr "Bronafbeelding is leeg."

#: includes/Abilities/LogoGen.php:138
msgid "A prompt is required describing how to edit the logo."
msgstr "Er is een prompt nodig die beschrijft hoe het logo te bewerken."

#: includes/Abilities/LogoGen.php:145
msgid "No site logo is set. Generate or upload a logo first."
msgstr "Er is geen sitelogo ingesteld. Genereer of upload eerst een logo."

#: includes/Abilities/LogoGen.php:150
msgid "Current site logo attachment could not be resolved."
msgstr "De huidige websitelogo-bijlage kon niet worden opgelost."

#: includes/Abilities/LogoGen.php:155
msgid "Image edit ability is unavailable."
msgstr "Beeldbewerkingsmogelijkheid is niet beschikbaar."

#. translators: %s: user edit instructions for the logo
#: includes/Abilities/LogoGen.php:160
#, php-format
msgid "Edit this logo as follows: %s. CRITICAL: Start from this exact logo image. Apply only the requested changes. Preserve transparent background unless the user asks otherwise. Do not invent a completely different logo design unless the user explicitly asks for a redesign."
msgstr "Bewerk dit logo als volgt: %s. KRITISCH: Begin met deze exacte logoafbeelding. Breng alleen de gevraagde wijzigingen toe. Behoud de transparante achtergrond tenzij de gebruiker anders vraagt. Bedenk geen volledig ander logoontwerp tenzij de gebruiker expliciet om een herontwerp vraagt."

#: includes/Abilities/LogoGen.php:179
msgid "Logo edit failed."
msgstr "Logo-bewerking mislukte."

#: includes/Abilities/LogoGen.php:191
msgid "No image URL in logo edit response."
msgstr "Geen afbeeldings-URL in het antwoord op logobewerking."

#: includes/Abilities/LogoGen.php:194
msgid "Site logo (AI edited)"
msgstr "Sitelogo (AI-bewerkt)"

#: includes/Abilities/LogoGen.php:218
msgid "Unable to retrieve Hiive authentication token for logo generation."
msgstr "Kan Hiive-authenticatietoken niet ophalen voor logogeneratie."

#: includes/Abilities/LogoGen.php:247
msgid "Logo generation timed out."
msgstr "Logogeneratie liep uit."

#. translators: %s: error message
#: includes/Abilities/LogoGen.php:252
#, php-format
msgid "Logo generation service unavailable: %s"
msgstr "Logogeneratiedienst niet beschikbaar: %s"

#. translators: %d: HTTP status code
#: includes/Abilities/LogoGen.php:261
#, php-format
msgid "Logo generation failed with status %d."
msgstr "Logogeneratie mislukte met status %d."

#: includes/Abilities/LogoGen.php:267
msgid "No image URL in response."
msgstr "Geen afbeeldings-URL als antwoord."

#: includes/Abilities/LogoGen.php:272
msgid "Site logo (AI generated)"
msgstr "Sitelogo (AI-gegenereerd)"

#. translators: %s: brand or site name for the logo attachment title/description
#: includes/Abilities/LogoGen.php:276
#, php-format
msgid "Site logo (AI generated) — %s"
msgstr "Sitelogo (AI-gegenereerd) — %s"

#: includes/Abilities/LogoGen.php:301
msgid "source_url is not allowed."
msgstr "source_url is niet toegestaan."

#: includes/Abilities/LogoGen.php:304
msgid "Site logo (uploaded)"
msgstr "Sitelogo (geüpload)"

#: includes/Abilities/LogoGen.php:335
msgid "Site logo updated."
msgstr "Sitelogo bijgewerkt."
