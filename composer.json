{
  "name": "newfold-labs/wp-module-mcp",
  "description": "WordPress MCP module for Newfold Labs BLU",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Micah Wood",
      "homepage": "https://wpscholar.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "BLU\\": "includes/"
    },
    "files": [
      "includes/functions.php",
      "bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BLU\\Tests\\": "tests/"
    }
  },
  "require": {
    "wordpress/mcp-adapter": "^0.3.0",
    "wordpress/abilities-api": "^0.4.0",
    "firebase/php-jwt": "^6.10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^1.1",
    "brain/monkey": "^2.6"
  },
  "config": {
    "platform": {
      "php": "8.1"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --testsuite=unit",
    "test:all": "phpunit",
    "test:coverage": "phpunit --coverage-html tests/_output/coverage"
  }
}